{
  "name": "nanagraphy-photo-booth",
  "version": "1.0.0",
  "description": "Offline-first Windows Photo Booth Desktop Application - NANAGRAPHY",
  "main": "dist-electron/main.js",
  "author": "NANAGRAPHY",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build && tsc -p tsconfig.electron.json && electron-builder",
    "preview": "next start -p 5173",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"next dev -p 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "next build && tsc -p tsconfig.electron.json && electron-builder --win",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "lucide-react": "^1.43.0",
    "next": "^15.5.12",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.0.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.nanagraphy.photobooth",
    "productName": "NANAGRAPHY Photo Booth",
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
